# Server-specific overrides — never committed, created on the host if needed.
/config.local.php

# Runtime state: database, encryption key, logs, caches.
/storage/*.sqlite
/storage/*.sqlite-wal
/storage/*.sqlite-shm
/storage/app_key.php
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
# Session files. Never committed, and so never deployed either — they are
# per-server state, and one of them is a live sign-in.
/storage/sessions/*
!/storage/sessions/.gitkeep

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Worker: local config and candidate lists stay on the machine that runs it.
/worker/config.json
/worker/candidates-*.csv
/worker/candidates-*.json
/worker/worker.log

# Signature logos, uploaded at runtime. Web-served so mail clients can fetch
# them, and kept out of version control because they are per-install content
# rather than part of the app. The FTP deploy adds files rather than mirroring,
# so what is on the server survives a release.
/assets/uploads/*
!/assets/uploads/.gitkeep
